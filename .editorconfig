# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
# apps/web (prettier: useTabs), scripts/ and the Kotlin plugin all indent with tabs
indent_style = tab

# packages/protocol predates the tab convention and uses two spaces; the VS Code
# extension keeps tabs in .ts but two-space JSON manifests
[packages/**.{ts,tsx,json}]
indent_style = space
indent_size = 2

[extensions/vscode/**.json]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
