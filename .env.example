# Optional environment for the repo's own CLI tooling (scripts/deploy.ts, scripts/project.ts).
# Neither editor extension reads this file: VS Code keeps its host token in SecretStorage and
# its server URL in settings.json (see extensions/vscode/README.md), and the JetBrains plugin
# keeps the equivalent in the IDE password safe and per-project settings (see
# extensions/jetbrains/README.md).

# --- `bun run deploy` (scripts/deploy.ts) ---
# Worker name: becomes part of the URL (https://<name>.<subdomain>.workers.dev) and of the KV
# namespace title (<name>-HOST_TOKENS). Defaults to "sourcebeam".
SOURCEBEAM_WORKER_NAME=sourcebeam

# --- `bun run project delete` (scripts/project.ts) ---
# Only needed if the worker sits behind a custom domain instead of the default workers.dev one;
# same effect as that command's --server flag. Leave unset to target the default deployment.
SOURCEBEAM_SERVER_URL=wss://sourcebeam.<subdomain>.workers.dev

# --- shared by both scripts, only matters with more than one Cloudflare account ---
# Picks which account to resolve the workers.dev subdomain against. Leave unset if `wrangler
# whoami` only ever shows one account — that's the common case and it's used automatically.
CLOUDFLARE_ACCOUNT_ID=
