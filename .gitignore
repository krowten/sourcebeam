# Gradle / IntelliJ Platform build output (extensions/jetbrains).
# gradle/wrapper/ is deliberately NOT ignored — the wrapper jar and properties are committed so
# a fork can build without installing Gradle first.
.gradle/
build/
.intellijPlatform/
.kotlin/

# This project's own scratch space (see CLAUDE.local.md) — throwaway experiments, agent
# reports, generated assets on their way to a real destination. Never meant to be committed.
.scratch/

# Machine-local coding-agent state: plugin/permission choices, workflow scratch files, browser
# session logs and page snapshots (may contain content from whatever was open at the time), and
# npm registry overrides. None of it is project config meant to be shared with contributors —
# except .claude/settings.json, the Claude Code plugins the project recommends.
.claude/*
!.claude/settings.json
.mcp.json
.superpowers/
.playwright-mcp/
.npmrc

