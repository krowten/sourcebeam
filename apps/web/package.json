{
	"name": "@sourcebeam/web",
	"description": "The sourcebeam server: a Cloudflare Worker with one Durable Object per project, plus the SvelteKit viewer",
	"version": "0.1.0",
	"license": "MIT",
	"author": {
		"name": "krowten",
		"email": "me@krowten.dev",
		"url": "https://github.com/krowten"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/krowten/sourcebeam",
		"directory": "apps/web"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler kv key put --binding=HOST_TOKENS dev-host 1 --local && wrangler dev --port 4173",
		"prepare": "svelte-kit sync || true",
		"check": "wrangler types && vite build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run && bun run test:do && bun run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"test:do": "vitest run --config vitest.workers.config.ts",
		"gen": "wrangler types"
	},
	"dependencies": {
		"@sourcebeam/protocol": "workspace:*",
		"shiki": "^4.5.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.23.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@vitest/browser-playwright": "^4.1.12",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.154.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
