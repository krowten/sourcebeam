{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		// false: src/worker.ts imports the generated `.svelte-kit/cloudflare/_worker.js` build
		// artifact. With checkJs on, TypeScript type-checks that file's entire (untyped, generated)
		// internals as part of the program, producing hundreds of unrelated errors from SvelteKit's
		// own output. allowJs (from $app/tsconfig) still lets TS infer the import's shape for
		// consumers, it just stops reporting diagnostics inside .js files.
		"checkJs": false,
		"sourceMap": true,
		"strict": true,
		// the last entry supplies the `cloudflare:test` module used by src/worker/*.spec.ts
		// (run by test:do through @cloudflare/vitest-pool-workers)
		"types": ["$app/types", "./worker-configuration.d.ts", "@cloudflare/vitest-pool-workers/types"]
	},
	"include": ["src", "*"]
}
