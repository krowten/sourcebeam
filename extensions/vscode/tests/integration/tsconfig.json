{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node", "vscode", "mocha"],
    "skipLibCheck": true,
    "outDir": "./out",
    "rootDir": ".",
    "noEmit": false
  },
  "include": ["suite/**/*.ts"]
}
